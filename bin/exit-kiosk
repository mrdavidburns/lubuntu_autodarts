#!/bin/bash
# exit-kiosk — drop a kiosk session back to LXQt for support work.
# Bound to Ctrl+Alt+Q via setup_exit_hotkey.sh.

set -e

# Stop the Chrome watchdog so it doesn't immediately respawn.
systemctl --user stop autodarts-chrome.service 2>/dev/null || true

# Kill any stray Chrome instances (covers chromium too).
pkill -f google-chrome-stable 2>/dev/null || true
pkill -f chromium 2>/dev/null || true

# Friendly notice via notify-send if available.
if command -v notify-send >/dev/null 2>&1; then
    notify-send "AutoDarts kiosk paused" \
        "Chrome stopped. Run 'systemctl --user start autodarts-chrome' to resume."
fi

# Smoke-test image: Ubuntu 24.04 with the deps essentials.sh would install
# pre-baked, plus a stub for the AutoDarts installer (network-isolated CI).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    bash sudo curl wget git ca-certificates lsb-release \
    util-linux logger jq python3 python3-venv python3-tk python3-dbus \
    libdbus-1-dev cron systemd alsa-utils libnotify-bin gpg \
    && rm -rf /var/lib/apt/lists/*

# Minimal kiosk user the script expects.
RUN useradd -m -G sudo,audio,video kiosk \
    && echo "kiosk ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/00-kiosk

WORKDIR /repo
ENTRYPOINT ["/bin/bash", "-l"]

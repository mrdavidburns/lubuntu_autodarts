#!/bin/sh
# Reapply panel settings after LXQt has saved and stopped its panel module.
set -u
mkdir -p "$HOME/.local/state"
exec >>"$HOME/.local/state/autodarts-panel-branding.log" 2>&1
printf '\n=== %s: applying LXQt panel branding ===\n' "$(date -Is)"
module=lxqt-panel.desktop
call_session() {
    dbus-send --session --print-reply --dest=org.lxqt.session /LXQtSession "org.lxqt.session.$1" "string:$module" >/dev/null
}
# LXQt starts normal autostart entries concurrently with the panel. Wait
# until its module is running before asking the session manager to stop it.
count=0
until pgrep -u "$(id -u)" -x lxqt-panel >/dev/null 2>&1; do
    count=$((count + 1))
    if [ "$count" -ge 30 ]; then
        echo 'LXQt panel did not start; branding will be retried at next login.' >&2
        exit 1
    fi
    sleep 1
done
if ! call_session stopModule; then
    echo 'Could not stop LXQt panel; branding will be retried at next login.' >&2
    exit 1
fi
restart_panel() { call_session startModule || echo 'Could not restart LXQt panel.' >&2; }
trap restart_panel EXIT
count=0
while pgrep -u "$(id -u)" -x lxqt-panel >/dev/null 2>&1; do
    count=$((count + 1))
    if [ "$count" -ge 20 ]; then
        echo 'LXQt panel did not stop; branding will be retried.' >&2
        exit 1
    fi
    sleep 1
done
if ! python3 "$HOME/.local/share/autodarts/configure_desktop.py"; then
    echo 'Could not apply LXQt branding; it will be retried.' >&2
    exit 1
fi
if ! call_session startModule; then
    echo 'Could not restart LXQt panel; branding will be retried.' >&2
    exit 1
fi
count=0
until pgrep -u "$(id -u)" -x lxqt-panel >/dev/null 2>&1; do
    count=$((count + 1))
    if [ "$count" -ge 20 ]; then
        echo 'LXQt panel did not restart; branding will be retried.' >&2
        exit 1
    fi
    sleep 1
done
trap - EXIT
echo 'LXQt panel branding applied.'
rm -f "$HOME/.config/autostart/autodarts-lxqt-branding.desktop"
